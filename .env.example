# ローカル開発（Homebrewでpostgresql@16をインストールし、`createdb samurai_dev` した場合の例）
# ユーザー名は省略不可（psqlと違いOSユーザーへの自動フォールバックがないため明示が必要）
DATABASE_URL="postgresql://<os-username>@localhost:5432/samurai_dev"

# 本番（Neon等ホスティング型Postgresの接続文字列の例。Neonの場合はPooled connection＝
# ホスト名に-poolerを含む方を使う。実行時のコネクション枯渇を避けるため）
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# prisma migrate deployはpooled connection（PgBouncerのtransaction pooling）だと
# アドバイザリーロック取得がタイムアウトすることがあるため、マイグレーション実行時だけ
# 非pooled（direct、ホスト名に-poolerが付かない方）の接続文字列をこちらに設定する。
# 未設定の場合はDATABASE_URLにフォールバックする（ローカル開発などpooler自体が無い環境向け）。
# DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# 独自ドメインでデプロイした後、絶対URL解決（OGP等）のために設定する
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 投稿元IPをハッシュ化する際のソルト（本番では推測されにくいランダムな文字列に変更すること）
IP_HASH_SALT="change-me-in-production"

# Wikidata同期用の管理APIを保護するシークレット（Netlify Scheduled Function
# netlify/functions/sync-wikidata.mts からのリクエストのAuthorization: Bearer
# ヘッダーと照合する。本番では推測されにくい値に変更すること）
CRON_SECRET="change-me-in-production"

# Auth.js（NextAuth v5）— JWT署名用のランダムな文字列。
# `openssl rand -base64 32` などで生成する。本番・ローカルそれぞれ別の値にすること。
AUTH_SECRET="change-me-in-production"

# Auth.jsはVercel/Cloudflare Pagesではホストを自動推測するが、それ以外のホスティング
# （Netlify等）では明示が必要。lib/auth.tsで trustHost: true を直接設定済みのため
# 実際にはこの変数は無くても動くはずだが、念のため二重で設定しておく。
AUTH_TRUST_HOST="true"

# 通常はtrustHostがリクエストヘッダーから自動解決するため設定不要（v5での説明: mostly
# unnecessary）。Netlifyで自動解決が効かない場合のフォールバックとして、本番のURLを
# 明示したい時だけ設定する。
# AUTH_URL="https://your-site.netlify.app"

# 本番DBへのシード投入用API（/api/admin/seed）を保護するシークレット。
# DATABASE_URLがSensitive設定でダッシュボード/CLIどちらからも値を取り出せない環境向けに、
# デプロイ済みのアプリ自身にシードを実行させるための一時的な仕組み。
SEED_SECRET="change-me-in-production"

# GoogleログインはGoogle Cloud ConsoleでOAuthクライアントを作成しないと使えない。
# 未設定でもCredentials（メール/パスワード）ログインは動作する。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# パスワードリセット・メール確認の送信に使うResend（https://resend.com）のAPIキー。
# 未設定の場合、メール送信はスキップされログに警告が出るのみ（機能自体は失敗させない）。
RESEND_API_KEY=""

# 送信元アドレス。Resend側で独自ドメインを検証していない場合は
# "onboarding@resend.dev" のままでよい（Resendのテスト用共有ドメイン）。
EMAIL_FROM="BlueScout <onboarding@resend.dev>"
