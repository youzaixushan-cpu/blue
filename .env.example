# ローカル開発（Homebrewでpostgresql@16をインストールし、`createdb samurai_dev` した場合の例）
# ユーザー名は省略不可（psqlと違いOSユーザーへの自動フォールバックがないため明示が必要）
DATABASE_URL="postgresql://<os-username>@localhost:5432/samurai_dev"

# 本番（Neon等ホスティング型Postgresの接続文字列の例）
# DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# 独自ドメインでデプロイした後、絶対URL解決（OGP等）のために設定する
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 投稿元IPをハッシュ化する際のソルト（本番では推測されにくいランダムな文字列に変更すること）
IP_HASH_SALT="change-me-in-production"
