# ローカル開発（Homebrewでpostgresql@16をインストールし、`createdb samurai_dev` した場合の例）
# ユーザー名は省略不可（psqlと違いOSユーザーへの自動フォールバックがないため明示が必要）
DATABASE_URL="postgresql://<os-username>@localhost:5432/samurai_dev"

# 本番（Neon等ホスティング型Postgresの接続文字列の例）
# DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# 独自ドメインでデプロイした後、絶対URL解決（OGP等）のために設定する
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 投稿元IPをハッシュ化する際のソルト（本番では推測されにくいランダムな文字列に変更すること）
IP_HASH_SALT="change-me-in-production"

# Wikidata同期用の管理APIを保護するシークレット（Vercel Cronからのリクエストの
# Authorization: Bearer ヘッダーと照合する。本番では推測されにくい値に変更すること）
CRON_SECRET="change-me-in-production"

# Auth.js（NextAuth v5）— JWT署名用のランダムな文字列。
# `openssl rand -base64 32` などで生成する。本番・ローカルそれぞれ別の値にすること。
AUTH_SECRET="change-me-in-production"

# 本番DBへのシード投入用API（/api/admin/seed）を保護するシークレット。
# DATABASE_URLがSensitive設定でダッシュボード/CLIどちらからも値を取り出せない環境向けに、
# デプロイ済みのアプリ自身にシードを実行させるための一時的な仕組み。
SEED_SECRET="change-me-in-production"

# GoogleログインはGoogle Cloud ConsoleでOAuthクライアントを作成しないと使えない。
# 未設定でもCredentials（メール/パスワード）ログインは動作する。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
