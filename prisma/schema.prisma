// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id            String  @id
  name          String
  nameEn        String
  position      String
  club          String
  age           Int
  height        Int
  weight        Int
  caps          Int
  goals         Int
  bio           String
  recentRatings Json
  career        Json
  avatarTheme   String
  officialSquad Boolean

  // Wikidataとの連携用（すべて任意 — 未マッチの選手はnullのまま、手入力のage/clubがフォールバックされる）
  birthDate      DateTime?
  wikidataId     String?
  // 直近の同期で確認できた所属クラブのQID。これが変わった時だけ実際の「移籍」とみなしclubを更新する
  // （Wikidata側のクラブ名表記ゆれだけで毎回clubの文言が変わってしまうのを防ぐため）
  currentClubQid String?
  lastSyncedAt DateTime?
}

model Match {
  id           String @id
  opponent     String
  opponentFlag String
  competition  String
  venue        String
  date         String
  score        String
  result       String
  scorers      Json
  lineup       Json
}

model CommunitySubmission {
  id          String                      @id @default(cuid())
  formationId String
  authorName  String
  title       String
  // 布陣のポイントや狙いを書ける任意のコメント
  comment     String?
  likes       Int                         @default(0)
  createdAt   DateTime                    @default(now())
  // 投稿元のIPをハッシュ化した値（レート制限用。生IPは保存しない）
  ipHash      String
  // "next"（次回選考）または "2030"（2030年W杯）。lib/squad-target.tsのSquadTargetと対応
  target      String                      @default("next")
  members     CommunitySubmissionMember[]
  likedBy     CommunitySubmissionLike[]

  @@index([ipHash, createdAt])
  @@index([target, createdAt])
}

model CommunitySubmissionMember {
  id           String              @id @default(cuid())
  submissionId String
  submission   CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  slotId       String
  playerId     String?
  name         String
  position     String
}

model PlayerRankStat {
  playerId String
  target   String @default("next")
  lastRank Int

  @@id([playerId, target])
}

// 同一訪問者（IPハッシュ）による同一投稿への連打いいねを防止するための記録
model CommunitySubmissionLike {
  id           String              @id @default(cuid())
  submissionId String
  submission   CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ipHash       String
  createdAt    DateTime            @default(now())

  @@unique([submissionId, ipHash])
}

// ここから Auth.js（NextAuth v5）標準のスキーマ。認証はGoogle OAuth + メール/パスワードの併用。
// Credentialsプロバイダーを使うためセッション戦略はjwt（databaseセッションは使わないが、
// アダプターの型要件・将来のOAuthセッション管理のためSessionモデル自体は用意しておく）。
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // メール/パスワードログイン用のハッシュ（bcryptjs）。OAuthのみで登録したユーザーはnull。
  password      String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  squad    UserSquad[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// 「あなたの26人」のアカウント連携保存。ログイン中はここに同期し、どの端末からでも同じ内容を見られるようにする。
// stateには従来lib/squad-context.tsxがlocalStorageに保存していたのと同じ形（members/formationId/assignmentsByFormation）をそのまま入れる。
// target（"next"/"2030"）ごとに別々の行を持つ＝ユーザーは最大2つの独立した編成を保存できる。
model UserSquad {
  userId    String
  target    String   @default("next")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     Json
  updatedAt DateTime @updatedAt

  @@id([userId, target])
}
