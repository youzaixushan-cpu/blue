// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id            String  @id
  name          String
  nameEn        String
  position      String
  club          String
  age           Int
  height        Int
  weight        Int
  caps          Int
  goals         Int
  bio           String
  recentRatings Json
  career        Json
  avatarTheme   String
  officialSquad Boolean

  // Wikidataとの連携用（すべて任意 — 未マッチの選手はnullのまま、手入力のage/clubがフォールバックされる）
  birthDate      DateTime?
  wikidataId     String?
  // 直近の同期で確認できた所属クラブのQID。これが変わった時だけ実際の「移籍」とみなしclubを更新する
  // （Wikidata側のクラブ名表記ゆれだけで毎回clubの文言が変わってしまうのを防ぐため）
  currentClubQid String?
  lastSyncedAt DateTime?
}

model Match {
  id           String @id
  opponent     String
  opponentFlag String
  competition  String
  venue        String
  date         String
  score        String
  result       String
  scorers      Json
  lineup       Json
}

model CommunitySubmission {
  id          String                      @id @default(cuid())
  formationId String
  authorName  String
  title       String
  likes       Int                         @default(0)
  createdAt   DateTime                    @default(now())
  // 投稿元のIPをハッシュ化した値（レート制限用。生IPは保存しない）
  ipHash      String
  members     CommunitySubmissionMember[]
  likedBy     CommunitySubmissionLike[]

  @@index([ipHash, createdAt])
}

model CommunitySubmissionMember {
  id           String              @id @default(cuid())
  submissionId String
  submission   CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  slotId       String
  playerId     String?
  name         String
  position     String
}

model PlayerRankStat {
  playerId String @id
  lastRank Int
}

// 同一訪問者（IPハッシュ）による同一投稿への連打いいねを防止するための記録
model CommunitySubmissionLike {
  id           String              @id @default(cuid())
  submissionId String
  submission   CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ipHash       String
  createdAt    DateTime            @default(now())

  @@unique([submissionId, ipHash])
}
